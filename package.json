{
  "name": "clinical-voice-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Root scripts — run npm commands from this folder or from voice-gateway/",
  "scripts": {
    "install:all": "npm install --prefix voice-gateway",
    "stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-ports.ps1",
    "backend": "powershell -ExecutionPolicy Bypass -File scripts/start-backend.ps1",
    "dev": "npm run dev --prefix voice-gateway",
    "client": "npm run dev",
    "ui": "npm run dev",
    "build": "npm run build --prefix voice-gateway"
  }
}
